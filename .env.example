# PostgreSQL connection string. This is a real double-entry ledger — Postgres only.
DATABASE_URL="postgresql://wave:wave_dev_password@localhost:5432/wave?schema=public"
# 32 random bytes, base64 — encrypts bank tokens & TINs at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="CHANGE_ME_32_BYTES_BASE64"

# --- Plaid (bank feeds) -------------------------------------------------------
# Leave PLAID_CLIENT_ID / PLAID_SECRET empty to run on the built-in sandbox feed.
# Keys: dashboard.plaid.com → Developers → Keys (sandbox and production differ).
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# "sandbox" until Plaid approves production access, then "production".
PLAID_ENV="sandbox"
# Public HTTPS URL Plaid calls with transaction updates, e.g.
# https://books.example.com/api/plaid/webhook. Without it, use "Sync now".
PLAID_WEBHOOK_URL=""

# --- Automatic month-to-month cycle -----------------------------------------
# AI fallback for categorization (console.anthropic.com). Without it, rules
# and built-in merchant rules still run; everything else waits for review.
ANTHROPIC_API_KEY=""
# Shared secret your host's scheduler sends to POST /api/cron/sync (daily).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# --- Client portal & email ----------------------------------------------------
# Public base URL of this app (used in invitation links).
APP_URL="http://localhost:3000"
# "console" prints emails to the server log (development). "smtp" sends them.
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Your Tax Solution <books@example.com>"
