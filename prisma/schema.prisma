// Wave 2.0 — Phase 1 data model: ledger core.
//
// Design principles (see PROJECT.md "Core accounting engine"):
//  - Every money amount is an integer in minor units (cents). Never floats.
//  - Journal entries are immutable once posted. Corrections happen via linked
//    reversing entries — enforced both in the service layer and by Postgres
//    triggers (see the ledger_immutability migration).
//  - Multi-currency: each entry carries a transaction currency + exchange rate;
//    every line stores both the transaction amount and the amount in the
//    business's functional currency. Reports aggregate functional amounts.
//  - Users/orgs/roles are modeled now so every ledger row has an owner and an
//    audit trail, even though interactive auth ships in a later phase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  // Null until interactive auth ships (later phase); never store plaintext.
  passwordHash String?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  journalEntries JournalEntry[]
  auditLogs    AuditLog[]

  @@map("users")
}

enum MembershipRole {
  OWNER
  ACCOUNTANT
  EMPLOYEE
  CONTRACTOR_VIEW

  @@map("membership_role")
}

model Business {
  id                   String   @id @default(cuid())
  name                 String
  legalName            String?
  // ISO 4217 code of the functional (home) currency, e.g. "USD".
  functionalCurrency   String   @default("USD")
  // 1–12; month the fiscal year starts (1 = January).
  fiscalYearStartMonth Int      @default(1)
  accountingBasis      AccountingBasis @default(ACCRUAL)
  // Per-business sequential journal entry numbering; bumped inside the
  // posting transaction so numbers are gapless and race-free.
  nextEntryNumber      Int      @default(1)
  createdAt            DateTime @default(now())

  memberships    Membership[]
  accounts       Account[]
  journalEntries JournalEntry[]
  auditLogs      AuditLog[]
  // Phase 2 — per-business sequential document numbering.
  nextInvoiceNumber  Int @default(1)
  nextEstimateNumber Int @default(1)
  customers         Customer[]
  vendors           Vendor[]
  taxRates          TaxRate[]
  invoices          Invoice[]
  payments          Payment[]
  estimates         Estimate[]
  expenses          Expense[]
  storedFiles       StoredFile[]
  recurringInvoices RecurringInvoice[]
  mileageEntries    MileageEntry[]
  // Phase 3 — banking
  bankConnections        BankConnection[]
  categorizationRules    CategorizationRule[]
  reconciliationSessions ReconciliationSession[]
  // Phase 4 — 1099 tracking
  vendorPayments VendorPayment[]
  // Phase 5 — payer identity for information returns. EIN is AES-256-GCM
  // ciphertext + last-4, same rules as vendor TINs.
  einEncrypted String?
  einLast4     String?
  taxStreet    String?
  taxCity      String?
  taxState     String?
  taxZip       String?
  form1099s    Form1099[]

  @@map("businesses")
}

enum AccountingBasis {
  CASH
  ACCRUAL

  @@map("accounting_basis")
}

model Membership {
  id         String         @id @default(cuid())
  userId     String
  businessId String
  role       MembershipRole
  createdAt  DateTime       @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Chart of accounts
// ---------------------------------------------------------------------------

// The five fundamental types drive normal balance and statement placement.
// COGS is a subtype of EXPENSE (see Account.subtype) so P&L can show a
// gross-profit section without complicating the debit/credit algebra.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE

  @@map("account_type")
}

model Account {
  id          String      @id @default(cuid())
  businessId  String
  // Human-facing ledger code, unique per business (e.g. "1000").
  code        String
  name        String
  type        AccountType
  // Free-form refinement used for reporting sections & future automation:
  // e.g. "cash_and_bank", "accounts_receivable", "cogs", "sales_tax".
  subtype     String?
  description String?
  // Optional account-level currency (bank account in EUR, etc.).
  // Null = functional currency of the business.
  currency    String?
  // Seeded from the standard template / required by the engine
  // (e.g. Retained Earnings); cannot be deleted, only renamed.
  isSystem    Boolean     @default(false)
  // Archived accounts are hidden from pickers but keep their history.
  isArchived  Boolean     @default(false)
  parentId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")
  lines    JournalLine[]

  @@unique([businessId, code])
  @@index([businessId, type])
  @@map("accounts")
}

// ---------------------------------------------------------------------------
// Journal (the ledger itself)
// ---------------------------------------------------------------------------

enum EntryStatus {
  // Editable scratch state; not visible to reports.
  DRAFT
  // Immutable. Enforced by DB triggers: no UPDATE/DELETE of the entry or its
  // lines. "Reversed" is not a status mutation — it's the presence of a
  // posted entry whose reversesId points here.
  POSTED
  // A draft that was discarded. Posted entries can never become VOID.
  VOID

  @@map("entry_status")
}

// Provenance of an entry.
enum EntrySource {
  MANUAL
  SYSTEM
  INVOICE
  PAYMENT
  EXPENSE
  BANK_IMPORT

  @@map("entry_source")
}

model JournalEntry {
  id          String      @id @default(cuid())
  businessId  String
  // Sequential per business, assigned at posting time.
  entryNumber Int?
  // Accounting date (date-only semantics, stored at UTC midnight).
  date        DateTime    @db.Date
  memo        String
  status      EntryStatus @default(DRAFT)
  source      EntrySource @default(MANUAL)
  // ISO 4217 transaction currency for all lines of this entry.
  currency    String
  // Multiply a transaction-currency amount by this to get functional
  // currency. Exactly 1 for same-currency entries. Stored as a decimal
  // (it's a rate, not money — money stays integer minor units).
  exchangeRate Decimal    @default(1) @db.Decimal(20, 10)
  postedAt    DateTime?
  createdAt   DateTime    @default(now())
  createdById String

  // Reversal linkage: the *reversing* entry points at the original, so the
  // original row is never touched. An entry with a non-null `reversedBy`
  // backlink is displayed as "Reversed".
  reversesId  String?       @unique
  reverses    JournalEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy  JournalEntry? @relation("Reversal")

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id])
  lines     JournalLine[]

  @@unique([businessId, entryNumber])
  @@index([businessId, date])
  @@index([businessId, status])
  @@map("journal_entries")
}

enum LineDirection {
  DEBIT
  CREDIT

  @@map("line_direction")
}

model JournalLine {
  id      String        @id @default(cuid())
  entryId String
  // Order within the entry, for stable display.
  lineNo  Int
  accountId String
  direction LineDirection
  // Always positive; direction carries the sign. Minor units of the entry's
  // transaction currency. DB CHECK constraints enforce positivity.
  amount  BigInt
  // Same line expressed in the business's functional currency minor units
  // (equals `amount` when the entry is in the functional currency).
  // Balance validation runs on BOTH columns.
  functionalAmount BigInt
  description String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@unique([entryId, lineNo])
  @@index([accountId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  // Null for system-initiated actions (jobs, migrations).
  userId     String?
  // e.g. "journal_entry.posted", "journal_entry.reversed", "account.created"
  action     String
  entityType String
  entityId   String
  // Redacted snapshot of what changed. Never put TINs/credentials here.
  payload    Json?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ===========================================================================
// Phase 2 — Invoicing & expenses
// ===========================================================================

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  address    String?
  // Preferred invoicing currency; null = business functional currency.
  currency   String?
  notes      String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  estimates Estimate[]
  recurringInvoices RecurringInvoice[]

  @@index([businessId, name])
  @@map("customers")
}

model Vendor {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  address    String?
  notes      String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // --- W-9 / 1099 (Phase 4) ---
  // Only true once W-9 data is complete; gates form generation.
  is1099Eligible Boolean  @default(false)
  w9Status       W9Status @default(NOT_REQUESTED)
  // Public token for the contractor-facing W-9 form (/w9/[token]).
  w9RequestToken String?  @unique
  w9RequestedAt  DateTime?
  w9CompletedAt  DateTime?
  legalName      String?
  businessName   String?
  taxEntityType  TaxEntityType?
  // TIN: AES-256-GCM ciphertext only; last 4 kept separately for masked
  // display. Plaintext never hits logs, audit payloads, or error messages.
  tinEncrypted   String?
  tinLast4       String?
  tinType        TinType?
  taxStreet      String?
  taxCity        String?
  taxState       String?
  taxZip         String?
  backupWithholding Boolean @default(false)
  // Recipient consent for electronic-only Copy B delivery (IRS requires
  // affirmative consent); null = paper mail required.
  eDeliveryConsentAt DateTime?
  // Which box payments default to for this vendor (e.g. rent vendors MISC_1).
  defaultBoxCode String   @default("NEC_1")
  // Uploaded signed W-9 (optional; structured data above is canonical).
  w9FileId       String?  @unique

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses Expense[]
  payments1099 VendorPayment[]

  @@index([businessId, name])
  @@map("vendors")
}

// Sales tax rate. Rate stored in parts-per-million so 8.875% = 88750 ppm —
// integer math only, no floats.
model TaxRate {
  id                 String  @id @default(cuid())
  businessId         String
  name               String
  jurisdiction       String?
  ratePpm            Int
  // Liability account credited when this tax is collected on an invoice.
  liabilityAccountId String
  isArchived         Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceLines  InvoiceLine[]
  estimateLines EstimateLine[]

  @@map("tax_rates")
}

enum InvoiceStatus {
  DRAFT   // editable, not yet on the books
  OPEN    // approved & posted to the ledger (A/R), awaiting payment
  PAID
  VOID

  @@map("invoice_status")
}

model Invoice {
  id           String        @id @default(cuid())
  businessId   String
  customerId   String
  number       Int
  status       InvoiceStatus @default(DRAFT)
  issueDate    DateTime      @db.Date
  dueDate      DateTime      @db.Date
  currency     String
  exchangeRate Decimal       @default(1) @db.Decimal(20, 10)
  memo         String?
  terms        String?
  // Denormalized totals in invoice-currency minor units (derived from lines
  // at approval; drafts recompute on edit).
  subtotal     BigInt        @default(0)
  taxTotal     BigInt        @default(0)
  total        BigInt        @default(0)
  // Ledger linkage: entry posted at approval; reversal entry if voided.
  journalEntryId     String? @unique
  voidJournalEntryId String? @unique
  // Public client-portal token (unguessable).
  portalToken  String        @unique @default(cuid())
  estimateId   String?       @unique
  recurringInvoiceId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  lines    InvoiceLine[]
  payments Payment[]
  estimate Estimate? @relation(fields: [estimateId], references: [id])
  recurringInvoice RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([businessId, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  lineNo      Int
  description String
  // Quantity in thousandths (2.5 units = 2500) — integer math only.
  quantityMilli BigInt @default(1000)
  // Unit price in invoice-currency minor units.
  unitPrice   BigInt
  // quantity × unitPrice, rounded half-up, minor units.
  amount      BigInt
  incomeAccountId String
  taxRateId   String?
  taxAmount   BigInt  @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id])

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

enum PaymentMethod {
  CASH
  CHECK
  ACH
  WIRE
  // Card / third-party network payments are excluded from 1099 totals
  // (1099-K territory, reported by the processor) — tracked from Phase 4.
  CARD
  OTHER

  @@map("payment_method")
}

model Payment {
  id         String        @id @default(cuid())
  businessId String
  invoiceId  String
  date       DateTime      @db.Date
  // Invoice-currency minor units.
  amount     BigInt
  method     PaymentMethod
  memo       String?
  // Bank/cash account debited.
  depositAccountId String
  journalEntryId   String? @unique
  createdAt  DateTime      @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([businessId, date])
  @@map("payments")
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  CONVERTED

  @@map("estimate_status")
}

model Estimate {
  id           String         @id @default(cuid())
  businessId   String
  customerId   String
  number       Int
  status       EstimateStatus @default(DRAFT)
  issueDate    DateTime       @db.Date
  expiryDate   DateTime?      @db.Date
  currency     String
  exchangeRate Decimal        @default(1) @db.Decimal(20, 10)
  memo         String?
  subtotal     BigInt         @default(0)
  taxTotal     BigInt         @default(0)
  total        BigInt         @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  lines    EstimateLine[]
  convertedInvoice Invoice?

  @@unique([businessId, number])
  @@map("estimates")
}

model EstimateLine {
  id          String  @id @default(cuid())
  estimateId  String
  lineNo      Int
  description String
  quantityMilli BigInt @default(1000)
  unitPrice   BigInt
  amount      BigInt
  incomeAccountId String
  taxRateId   String?
  taxAmount   BigInt  @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  taxRate  TaxRate? @relation(fields: [taxRateId], references: [id])

  @@unique([estimateId, lineNo])
  @@map("estimate_lines")
}

model Expense {
  id           String        @id @default(cuid())
  businessId   String
  vendorId     String?
  date         DateTime      @db.Date
  memo         String
  currency     String
  exchangeRate Decimal       @default(1) @db.Decimal(20, 10)
  // Account credited (bank / cash / credit card payable).
  paymentAccountId String
  paymentMethod    PaymentMethod @default(OTHER)
  total        BigInt        @default(0)
  journalEntryId String?     @unique
  receiptFileId  String?     @unique
  createdAt    DateTime      @default(now())

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vendor   Vendor?     @relation(fields: [vendorId], references: [id])
  lines    ExpenseLine[]
  receiptFile StoredFile? @relation(fields: [receiptFileId], references: [id])

  @@index([businessId, date])
  @@index([vendorId, date])
  @@map("expenses")
}

model ExpenseLine {
  id        String @id @default(cuid())
  expenseId String
  lineNo    Int
  description String?
  expenseAccountId String
  amount    BigInt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, lineNo])
  @@map("expense_lines")
}

// Uploaded files (receipts now; W-9s and generated PDFs later). Bytes live in
// the storage backend (local disk adapter in dev, S3-compatible in prod);
// this row is the metadata + key.
model StoredFile {
  id         String   @id @default(cuid())
  businessId String
  key        String   @unique
  filename   String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expense  Expense?

  @@map("stored_files")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY

  @@map("recurrence_frequency")
}

model RecurringInvoice {
  id         String              @id @default(cuid())
  businessId String
  customerId String
  frequency  RecurrenceFrequency
  nextRunDate DateTime           @db.Date
  endDate    DateTime?           @db.Date
  // Snapshot of invoice fields applied on each run:
  // { currency, exchangeRate, terms, memo, dueInDays,
  //   lines: [{description, quantityMilli, unitPrice, incomeAccountId, taxRateId?}] }
  template   Json
  // If true the generated invoice is approved (posted to A/R) immediately;
  // otherwise it lands as a draft for review.
  autoApprove Boolean            @default(false)
  isPaused   Boolean             @default(false)
  createdAt  DateTime            @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  invoices Invoice[]

  @@index([businessId, nextRunDate])
  @@map("recurring_invoices")
}

model MileageEntry {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime @db.Date
  // Distance in tenths of a mile (12.5 mi = 125).
  milesTenths Int
  // Deduction rate in cents-per-mile at time of entry (IRS standard mileage
  // rate — configuration, not a constant; changes yearly).
  ratePerMileCents Int
  purpose    String
  vehicle    String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
  @@map("mileage_entries")
}

// ===========================================================================
// Phase 3 — Bank feeds & reconciliation
// ===========================================================================

enum BankConnectionStatus {
  ACTIVE
  ERROR
  DISCONNECTED

  @@map("bank_connection_status")
}

// A connection to a bank data provider. `provider` selects the adapter:
// "mock" (deterministic sandbox feed) or "plaid" (real credentials required).
model BankConnection {
  id              String               @id @default(cuid())
  businessId      String
  provider        String
  institutionName String
  status          BankConnectionStatus @default(ACTIVE)
  // Provider access token, AES-256-GCM encrypted (see src/lib/crypto.ts).
  // Never stored in plaintext; null for the mock provider.
  accessTokenEncrypted String?
  // Mock feed cursor; also useful as a generic sync counter.
  syncCount       Int                  @default(0)
  lastSyncAt      DateTime?
  createdAt       DateTime             @default(now())

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accounts BankAccountLink[]

  @@map("bank_connections")
}

// One bank/card account inside a connection, mapped onto a ledger account
// from the chart of accounts. All imported activity for the link lands
// against that ledger account.
model BankAccountLink {
  id                String @id @default(cuid())
  connectionId      String
  businessId        String
  externalAccountId String
  name              String
  mask              String?
  currency          String
  ledgerAccountId   String

  connection   BankConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions ImportedTransaction[]

  @@unique([connectionId, externalAccountId])
  @@map("bank_account_links")
}

enum ImportedTxnStatus {
  // Imported, not yet on the books.
  PENDING
  // A journal entry was created from this transaction.
  CATEGORIZED
  // Matched to an already-posted journal line — no new entry.
  MATCHED
  // Deliberately kept off the books (duplicates, personal spend).
  EXCLUDED

  @@map("imported_txn_status")
}

model ImportedTransaction {
  id                String            @id @default(cuid())
  businessId        String
  bankAccountLinkId String
  // Provider's transaction id; the unique constraint makes re-syncs idempotent.
  externalId        String
  date              DateTime          @db.Date
  description       String
  // Signed, in minor units of the link currency: negative = money out.
  // (Sign convention lives only at the import boundary — the ledger side
  // always uses direction + positive amounts.)
  amount            BigInt
  status            ImportedTxnStatus @default(PENDING)
  // Set when categorized:
  journalEntryId    String?           @unique
  // Set when matched to an existing posted line:
  matchedJournalLineId String?        @unique
  // Prefill from rules / frequency heuristics; user confirms.
  suggestedAccountId   String?
  suggestedByRuleId    String?
  createdAt         DateTime          @default(now())

  bankAccountLink BankAccountLink @relation(fields: [bankAccountLinkId], references: [id], onDelete: Cascade)

  @@unique([bankAccountLinkId, externalId])
  @@index([businessId, status])
  @@index([bankAccountLinkId, date])
  @@map("imported_transactions")
}

enum RuleMatchType {
  CONTAINS
  REGEX

  @@map("rule_match_type")
}

enum RuleDirection {
  INFLOW
  OUTFLOW
  BOTH

  @@map("rule_direction")
}

model CategorizationRule {
  id         String        @id @default(cuid())
  businessId String
  pattern    String
  matchType  RuleMatchType @default(CONTAINS)
  appliesTo  RuleDirection @default(BOTH)
  accountId  String
  // Lower number wins when several rules match.
  priority   Int           @default(100)
  createdAt  DateTime      @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, priority])
  @@map("categorization_rules")
}

enum ReconciliationStatus {
  OPEN
  COMPLETED

  @@map("reconciliation_status")
}

// A statement-reconciliation working session: pick a ledger account and a
// statement period, enter the statement's opening/closing balances, then work
// the imported transactions until the variance hits zero.
model ReconciliationSession {
  id              String               @id @default(cuid())
  businessId      String
  ledgerAccountId String
  statementStart  DateTime             @db.Date
  statementEnd    DateTime             @db.Date
  // Statement balances in functional-currency minor units.
  startingBalance BigInt
  endingBalance   BigInt
  status          ReconciliationStatus @default(OPEN)
  completedAt     DateTime?
  createdAt       DateTime             @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@map("reconciliation_sessions")
}

// ===========================================================================
// Phase 4 — W-9 collection & 1099 payment tracking
// ===========================================================================

enum TaxEntityType {
  INDIVIDUAL_SOLE_PROP
  C_CORP
  S_CORP
  PARTNERSHIP
  TRUST_ESTATE
  LLC_C
  LLC_S
  LLC_P
  OTHER

  @@map("tax_entity_type")
}

enum TinType {
  SSN
  EIN

  @@map("tin_type")
}

enum W9Status {
  NOT_REQUESTED
  REQUESTED
  COMPLETED

  @@map("w9_status")
}

// Where a vendor payment came from.
enum VendorPaymentSource {
  EXPENSE
  MANUAL

  @@map("vendor_payment_source")
}

// A payment to a vendor tracked for information-return purposes. Created
// automatically from expenses with a vendor, or logged manually (checks,
// wires outside the app). Amounts are functional-currency minor units.
//
// 1099-K exclusion: payments made by credit card / third-party network are
// reported by the processor, not the payer — excludedFrom1099 is set at
// creation from the payment method and the box totals never include them.
model VendorPayment {
  id         String              @id @default(cuid())
  businessId String
  vendorId   String
  date       DateTime            @db.Date
  amount     BigInt
  method     PaymentMethod
  // Which 1099 box this payment accrues to: NEC_1, MISC_1 (rents),
  // MISC_2 (royalties), MISC_3 (other), INT_1, DIV_1A. Config lives in
  // src/lib/forms1099/boxes.ts.
  boxCode    String              @default("NEC_1")
  source     VendorPaymentSource @default(MANUAL)
  expenseId  String?             @unique
  memo       String?
  excludedFrom1099 Boolean       @default(false)
  createdAt  DateTime            @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vendor   Vendor   @relation(fields: [vendorId], references: [id])

  @@index([vendorId, date])
  @@index([businessId, date])
  @@map("vendor_payments")
}

// Per-tax-year IRS thresholds — configuration, NOT code constants, because
// they change: the 1099-NEC/MISC minimum moved from $600 to $2,000 for tax
// years beginning after 2025 (OBBBA), with inflation adjustments from 2027.
// Values are minor units (cents). Seeded values must be verified against
// IRS.gov before filing season — the UI says so too.
model TaxYearConfig {
  taxYear             Int    @id
  necMiscThreshold    BigInt
  intThreshold        BigInt
  divThreshold        BigInt
  // Combined information returns at/above which e-filing is mandatory.
  efileMandateCount   Int    @default(10)
  notes               String?

  @@map("tax_year_configs")
}

// ===========================================================================
// Phase 5 — 1099 form generation, e-file, corrections
// ===========================================================================

enum Form1099Status {
  // Generated from payment data; amounts editable in review.
  DRAFT
  // Reviewed and locked for submission.
  READY
  // Sent to the transmitter; awaiting IRS response. Immutable from here on.
  SUBMITTED
  ACCEPTED
  REJECTED

  @@map("form1099_status")
}

// One information return (one vendor, one year, one form kind, one version).
// Versioning: corrections create a NEW row with version+1 and correctsId
// pointing at the previously filed form — filed forms are never edited.
model Form1099 {
  id         String         @id @default(cuid())
  businessId String
  vendorId   String
  taxYear    Int
  // 'NEC' | 'MISC' ('INT'/'DIV' stubbed).
  formKind   String
  version    Int            @default(1)
  status     Form1099Status @default(DRAFT)
  // Correction chain: this form corrects the one referenced.
  correctsId String?        @unique
  corrects   Form1099?      @relation("Correction", fields: [correctsId], references: [id])
  correctedBy Form1099?     @relation("Correction")

  // Box amounts in minor units, keyed by box number string (e.g. {"1": 230000}).
  amounts    Json
  // Snapshots frozen at generation (re-editable while DRAFT only):
  // payer: { name, addressLine, tinLast4 } — full EIN read from Business at
  // submit/render time, never stored here.
  payer      Json
  // recipient: { name, addressLine, tinLast4, tinType } — same rule for TIN.
  recipient  Json

  transmitter     String?
  submissionId    String?
  submittedAt     DateTime?
  acceptedAt      DateTime?
  rejectionReason String?

  copyBDeliveredAt     DateTime?
  // 'electronic' (requires vendor e-consent) or 'mail'.
  copyBDeliveryMethod  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, vendorId, taxYear, formKind, version])
  @@index([businessId, taxYear, status])
  @@map("form1099s")
}
